{
  "name": "CodeSnap Acode Plugin",
  "version": "1.0.0",
  "description": "Turn your code into a clean, shareable PNG image, right from the Acode editor. CodeSnap renders the selected code (or the whole file) inside a window-style card with the file name, using the same syntax highlighting as your editor or one of the built-in themes.",
  "main": "dist/main.js",
  "repository": "",
  "author": "Ronilson Rsj",
  "license": "MIT",
  "dependencies": {
    "acode-plugin-types": "^1.12.9",
    "html-tag-js": "^2.4.15",
    "style-loader": "^4.0.0"
  },
  "devDependencies": {
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "esbuild": "^0.27.2",
    "esbuild-sass-plugin": "^3.7.0",
    "jszip": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --serve",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "commit": "cz"
  },
  "browserslist": "cover 100%,not android < 5",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "cz-config.js"
    }
  }
}